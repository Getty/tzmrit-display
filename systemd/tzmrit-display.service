[Unit]
Description=HONGTAI USB LCD system monitor
Documentation=https://github.com/Getty/tzmrit-display
After=graphical-session.target
# The panel hangs off a USB port that may not exist yet at boot, and a bad USB
# port can crash-loop the process; keep restart attempts going indefinitely
# instead of letting systemd give up after the default 5-in-10s. This key only
# takes effect in [Unit] - in [Service] systemd ignores it.
StartLimitIntervalSec=0

# %h is the home directory. If the project lives elsewhere, adjust both paths.
[Service]
Type=simple
ExecStart=%h/dev/display/.venv/bin/python -m tzmrit_display run --claude --interval 1.0 --brightness 100
WorkingDirectory=%h/dev/display
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
